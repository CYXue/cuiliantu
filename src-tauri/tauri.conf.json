{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CuiLianTu",
  "version": "0.2.1",
  "identifier": "app.cuiliantu.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CuiLianTu",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:1420 http://127.0.0.1:1420",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' http://localhost:1420 http://127.0.0.1:1420",
        "style-src": "'self' 'unsafe-inline' http://localhost:1420 http://127.0.0.1:1420",
        "img-src": "'self' data: asset: blob: http://localhost:1420 http://127.0.0.1:1420",
        "font-src": "'self' data: http://localhost:1420 http://127.0.0.1:1420",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 ws://127.0.0.1:1420 http://localhost:1420 http://127.0.0.1:1420",
        "object-src": "'none'",
        "base-uri": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Batch image optimization and conversion tool",
    "longDescription": "CuiLianTu (淬炼图) is a fast desktop app for batch image compression, format conversion, resizing and watermarking. Everything runs locally, so your photos never leave your machine.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist",
      "exceptionDomain": null
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "languages": ["English", "Japanese", "SimpChinese"],
        "displayLanguageSelector": true
      }
    }
  }
}
